          "section": "Remaniements",
          "hidden": false
        },
        {
          "type": "test",
          "section": "Mesures et tests",
          "hidden": false
        },
        {
          "type": "chore",
          "section": "Entretien",
          "hidden": false
        }
      ]
    }
  }
